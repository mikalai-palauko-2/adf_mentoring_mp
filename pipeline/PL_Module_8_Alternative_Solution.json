									"type": "Int32",
									"physicalType": "int"
								}
							},
							{
								"source": {
									"name": "PurchaseAmount",
									"type": "Decimal",
									"physicalType": "decimal",
									"scale": 1,
									"precision": 38
								},
								"sink": {
									"name": "PurchaseAmount",
									"type": "Decimal",
									"physicalType": "decimal",
									"scale": 1,
									"precision": 10
								}
							},
							{
								"source": {
									"name": "PurchaseQuantity",
									"type": "Int32",
									"physicalType": "int"
								},
								"sink": {
