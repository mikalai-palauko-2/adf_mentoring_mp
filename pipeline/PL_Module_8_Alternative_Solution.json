			{
				"name": "Populate FactOnlinePurchase_MonthlySnapshot",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Populate DimOnlineService",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "WITH CTE_AllSales AS (   \n    SELECT\n        year(prch.TransactionDate)*10000 + month(prch.TransactionDate)*100 AS MonthKey,\n        dim_srvc.ServiceKey AS OnlineServiceKey,\n        prch.Price,\n        prch.TransactionId\n    FROM dbo.tOnlinePurchase AS prch\n    INNER JOIN dbo.tOnlineService AS srvc\n        ON prch.ServiceId = srvc.ServiceId\n    INNER JOIN dbo.DataMart_DimOnlineService AS dim_srvc\n        ON srvc.ServiceName = dim_srvc.ServiceName\n)\nSELECT\n    MonthKey,\n    OnlineServiceKey,\n    SUM(Price) AS PurchaseAmount,\n    COUNT(Price) AS PurchaseQuantity\nFROM CTE_AllSales\nGROUP BY MonthKey, OnlineServiceKey;\n ",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "AzureSqlSink",
						"preCopyScript": "TRUNCATE TABLE dbo.FactOnlinePurchase_MonthlySnapshot;",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "MonthKey",
									"type": "Int32",
									"physicalType": "int"
								},
								"sink": {
